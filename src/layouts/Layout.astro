---
import "@/styles/global.css"
import dibujoLogo from "@/assets/images/hojas.png"
import { CONSTANTS } from "@/constants/constants"

const base_path = CONSTANTS.BASE_PATH

interface Props {
	ogUrl?: string,
	ogTitle?: string,
	ogDescription?: string,
	ogImage?: string 

}

const {
	ogUrl = Astro.site, 
	ogTitle = "Nicolás Donoso Web", 
	ogDescription = "Nico tiene una página donde publica parte de su mundo",
	ogImage = "og_portada.png"
	} = Astro.props

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href=`${base_path}/favicon.svg`/>
		<link rel="icon" href=`${base_path}/favicon.ico`>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&family=Zilla+Slab:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Oregano:ital@0;1&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&family=Zilla+Slab:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">		
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Nicolás Donoso</title>
		<meta property="og:type" content="website" />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={new URL(`og/${ogImage}`, Astro.site)} />
		<meta property="og:image:width" content="1200" />
  		<meta property="og:image:height" content="630" />
	</head>
	<body>
		<header>
			<nav>
				<ul class="nav-list">
					<li><a class="nav-link logo-link" href=`${base_path}/`><img src={dibujoLogo.src} alt="Logo" loading="eager" class="logo-image"></a></li>
					<li><a class="nav-link subtitles" href=`${base_path}/bio`>bio</a></li>
					<li><a class="nav-link subtitles" href=`${base_path}/blog`>blog</a></li>
					<li><a class="nav-link subtitles" href=`https://sites.google.com/view/catalogo-nicolas-donoso/catalog` target="_blank" >catálogo<sub>↪</sub></a></li>
				</ul>
			</nav>
		</header>
        <main>
            <slot />
        </main>
		<footer>
			<div class="footer-wrapper">
				<ul class="footer-list">
					<li><a href="https://www.instagram.com/niconicodonoso/" target="_blank" class="footer-link content">@niconicodonoso</a></li>
					<li><a href="https://www.instagram.com/nicosodonoso/" target="_blank" class="footer-link content">@nicosodonoso</a></li>
					<li><a href="https://github.com/muinicomuiser/" target="_blank" class="footer-link content">github</a></li>
				</ul>
			</div>
		</footer>
	</body>
</html>

<style>
	body {
		background-color: var(--primary-bg-color);
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		align-content: center;
	}  
	header, footer {
		flex-shrink: 0; 
	}
	main {
		flex: 1;
  		display: grid;
	}	
	header {
		height: 4rem;
		display: flex;
		justify-content: center;
	}

	.logo-image {
		position: relative;
		height: 3rem;
		width: auto;
	}
	nav {
		position: relative;
		padding: 0 5%;
		border-bottom: 2px dotted var(--font-color);
		display: flex;
		align-items: center;
	}
	.nav-list {
		display: flex;
		flex-flow: row;
		align-items: center;
		list-style-type: none;
		gap: 3rem;
	}
	sub {
		font-size: 1rem;
		align-self: flex-end;
	}	
	.nav-link {
		display: flex;
		text-align: center;
		text-decoration: none;
		justify-self: center;
	}
	
	footer {
		flex-shrink: 0;
	}
	.footer-wrapper {
		height: 3rem;
		display: flex;
		align-content: center;
		justify-content: space-around;
	}
	.footer-list {
		border-top: 2px dotted var(--font-color);
		padding: 0 10%;
		display: flex;
		align-content: center;
		justify-content: space-evenly;
		align-items: center;
		list-style-type: none;
		gap: 1vw;
	}
	.footer-link {
		text-decoration: none;
		text-align: center;
	}

	/* Adaptación a Teléfono */
	@media (max-width: 480px) {
		header {
			height: 6rem;
			justify-content: center;

		}
		.nav-list {
			display: grid;
			grid-template-columns: 2fr 2fr; 
			gap: 0;
			align-self: center;
		}		
		.footer-wrapper {
			height: 5rem;
			display: flex;
			align-content: center;
		}		
		.footer-list {
			justify-content: space-around;
			flex-direction: column;
		}		
	}


</style>
<style is:global>
	*, *::before, *::after {
	box-sizing: border-box;
	}	
	* {
		margin: 0;
		padding: 0;
		font-family: "Source Sans 3", sans-serif;
		color: var(--font-color)
	}

	.title {
		font-size: var(--head-font-size);
		font-weight: var(--head-font-weight);
		line-height: var(--head-line-height);
		letter-spacing: var(--head-letter-spacing);
	}

	.subtitles {
		font-size: var(--subtitles-font-size);
		font-weight: var(--subtitles-font-weight);
		line-height: var(--subtitles-line-height);
		letter-spacing: var(--subtitles-letter-spacing);
	}
	.content-title {
		font-size: var(--content-title-font-size);
		font-weight: var(--content-title-font-weight);
		line-height: var(--content-title-line-height);
		letter-spacing: var(--content-title-letter-spacing);
	}
	.content {
		font-size: var(--content-font-size);
		font-weight: var(--content-font-weight);
		line-height: var(--content-line-height);
		letter-spacing: var(--content-letter-spacing);
	}
</style>

