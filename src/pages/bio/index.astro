---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets"
import fotoYo from "@/assets/images/yo7.png"


---

 <Layout>
        <div class="bio-wrapper">
            <Image src={fotoYo} loading="eager"  alt="Foto de Nicolás" class="bio-image" />
            <div class="bio-content">
                <h2>nicolás donoso</h2>
                <p class="bio-text subtitles">
                    Artista visual licenciado en Artes Plásticas por la Universidad de Chile, 
                    especializado en pintura y dibujo, y con estudios de piano y teoría musical. <br>
                    <br>
                    Su trabajo artístico dialoga con los conceptos de ecosistema, naturaleza y comunidad. 
                    Usa dibujos de trazos copiosos y serenos para mostrar una humanidad en su forma más elemental, 
                    que convive y compone sus ritos junto a la naturaleza; una sensación de humanidad latente que busca la vida comunitaria, 
                    que se relaciona con el mundo caminando, observando, agrupándose, buscando y creando refugios y lugares santos.<br>
                    <br>
                    El paisaje aparece en su obra como el espacio vasto y frágil en que se da lo humano, encarnando a los lugares 
                    que constituyen una identidad común y que están actualmente en crisis.
                </p>
            </div>
        </div>
 </Layout>

 <style>
	/* main {
		flex-grow: 1; 
	}     */
    .bio-wrapper {
		display: flex;
		align-items: center;
        justify-content: space-evenly;
		align-self: center;
		justify-self: center;        
    }
    .bio-content {
        gap: 2rem;
        display: flex;
        flex-flow: column;
        width: 50%;
        /* height: 100vh; */
        justify-content: space-evenly;
    }
    h2 {
        height: auto;
		font-family: "Oregano", cursive;
        font-size: 96;
		font-weight: 400;
		letter-spacing: 10;
		line-height: var(--head-line-height);
    }

    .bio-text {
        text-align: justify;
        align-content: center;
        
        /* font-family: "Oregano", cursive;
		font-size: 96;
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: 20;
		text-align: left; */
    }
    
    .bio-image {
        height: 60vh;
        width: auto;
    }
	/* Adaptación a Teléfono */
	@media (max-width: 480px) {
        .bio-wrapper {
            display: flex;
            align-items: center;
            /* flex-direction: row; */
            /* flex-direction: column; */
            align-self: center;
            justify-self: center;                 

            padding: 2rem 0;
            gap: 2rem;
            flex-direction: column;
            justify-content: space-between;
		}		
		.bio-content {
            width: auto;
		}		
		.bio-image {
            width: 50vw;
            height: auto;
        }		
		h2 {
            font-size: 3rem;
            text-align: center;
        }		
        
		.bio-text {
            font-size: 1.2rem;
            text-align: justify;
            width: 80vw;
        }		
	}    
 </style>
