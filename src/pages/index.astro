---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets"
import dibujoPortada from "@/assets/images/a.png"


---
 <Layout>
	<div class="home-wrapper">
		<div class="logo">nicolás donoso</div>
		<!-- <img src="public/imagenes/a.png" loading="eager"  alt="El dibujo de un árbol" class="home-image"> -->
		<Image src={dibujoPortada} loading="eager"  alt="El dibujo de un árbol" class="home-image" />

	</div>
 </Layout>
<style>
	.home-wrapper {
		display: flex;
		align-items: center;
		flex-direction: column;
		align-self: center;
		justify-self: center;
	}
	.home-image {
		width: 100%;
		max-width: 1080;
		height: auto;
		object-fit: cover;
	}	 
	.logo {
		font-family: "Oregano", cursive;
		font-size: 128;
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: 20;
		text-align: center;
	}
</style>