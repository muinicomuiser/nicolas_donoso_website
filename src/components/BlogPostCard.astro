---
import type { CollectionEntry } from 'astro:content'
import { CONSTANTS } from "@/constants/constants";
const base_path = CONSTANTS.BASE_PATH
interface Props {
    post: CollectionEntry<"posts">
}
const {post} = Astro.props
---


<div class="post-card">
    <p class="post-title subtitles">{post.data.title}</p>
    <p class="post-date content">{post.data.date}</p>
    <p class="post-subtitle content">{post.data.subtitle}</p>
    <a href={`${base_path}/blog/${post.id}`} style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 1;"></a>
</div>  

<style>
    .post-card {
        display: grid;
        width: 100%;       
        box-sizing: border-box;        
        background-color: var(--primary-bg-color-80);
        position: relative;
        grid-template-rows: 1fr 1fr 1fr;
        padding: 2rem 2rem;
        margin: 20px auto;
        border: 1px dotted var(--font-color);
        max-width: 50rem; 
    }
    .post-title {
    }
    .post-card:hover {
        background-color: #fefefe;
    }
</style>